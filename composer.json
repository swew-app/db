{
    "name": "swew/db",
    "type": "library",
    "description": "A lightweight, fast, and secure PHP library for interacting with databases through SQL models and queries. swew/db uses prepared statements to protect against SQL injection attacks and supports multiple database systems.",
    "keywords": [
        "database",
        "model",
        "pdo",
        "orm"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "AVIL13",
            "email": "avil@swew.app"
        }
    ],
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "autoload": {
        "psr-4": {
            "Swew\\Db\\": "src/"
        },
        "files": [],
        "exclude-from-classmap": [
            "spec",
            "/Tests/",
            "/test/",
            "/tests/"
        ]
    },
    "bin": ["bin/swew-migrate"],
    "autoload-dev": {
        "psr-4": {
            "Swew\\Testing\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "carthage-software/mago": "^1.59",
        "swew/dd": "^1.4.2",
        "swew/test": "^1.7.0"
    },
    "scripts": {
        "test": "t",
        "static": "mago analyze --minimum-report-level=error",
        "stan": "@static",
        "lint": "mago lint --minimum-report-level=error",
        "format": "mago fmt",
        "code-check": "mago fmt --check",
        "check": [
            "@static",
            "@lint",
            "@code-check"
        ]
    }
}
